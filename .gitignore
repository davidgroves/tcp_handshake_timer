# GitHub Go.gitignore — https://github.com/github/gitignore/blob/main/Go.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment files
.env
.env.*

# Editor/IDE
.idea/
.vscode/

# Project build output
/bin/
/thtimer

# bpf2go generated artifacts (from internal/ebpf/go:generate)
internal/ebpf/*_bpfel.go
internal/ebpf/*_bpfeb.go
internal/ebpf/*.o
bpf/vmlinux.h

# eBPF / C object files
*.o
